# Copy this file to ".env" and put your real values there.
# ".env" is ignored by git, ".env.example" is safe to upload.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Cloud MySQL (Aiven etc.): use ONE of these two
# DB_SSL_CA=ca.pem
# DB_SSL=True

# Only when the site runs on a https domain (comma separated)
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
